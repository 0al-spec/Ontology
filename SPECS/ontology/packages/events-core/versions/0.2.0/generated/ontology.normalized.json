  "modelApplicability" : {
    "appliesTo" : {
      "contexts" : [
        "draft_vocabulary_review",
        "offline_consumer_contract_design"
      ],
      "domains" : [
        "general_event_modeling"
      ]
    },
    "assumptions" : [
      {
        "id" : "manual_semantic_review",
        "text" : "Selected instance profiles enforce bounded structural/admission rules. Citation relevance, completeness and factual truth require separate trusted review."
      },
      {
        "id" : "observation_availability",
        "text" : "Only candidates use StateObservation availability. StateSnapshot declares a complete supplied state; unknown/partial observations never become empty snapshots or a record's direct states."
      }
    ],
    "excludes" : {
      "contexts" : [
        "automatic_liability_assignment",
        "trusted_physical_causation",
        "unselected_runtime_profile"
      ]
    },
    "invalidationTriggers" : [
      {
        "id" : "instance_contract_changed",
        "text" : "Re-review package vocabulary and mappings when the chosen pinned InstanceGraph/profile contract changes."
      }
    ]
  },
  "namespace" : "eventcore",
  "policies" : [
    {
      "appliesTo" : [
        "eventcore:CausalHypothesis"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:BoundedCausalHypothesis",
      "id" : "BoundedCausalHypothesis",
      "text" : "Cause/effect Interpretations derive their endpoint records through interpretsRecord; both records must belong to the same EventRegistry revision and have distinct recordKeys, the same clockKey, valid intervals and cause start no later than effect start. Overlap is allowed. Proposal review does not prove causation; graph/temporal checks belong to the selected instance profile and no responsibility is transferred."
    },
    {
      "appliesTo" : [
        "eventcore:EventCandidate",
        "eventcore:Interpretation",
        "eventcore:InterpretationCandidate"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:CandidateAuthorityBoundary",
      "id" : "CandidateAuthorityBoundary",
      "text" : "Candidate review is not event registration, factual truth, human attribution or responsibility. Package validation and generated schemas establish structure only; the selected instance profile checks references, state alternatives and explicit origin/enrichment admission; normative responsibility remains external."
    },
    {
      "appliesTo" : [
        "eventcore:EventCandidate",
        "eventcore:InterpretationCandidate",
        "eventcore:RecordedEvent"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:ExplicitEnrichmentAdmission",
      "id" : "ExplicitEnrichmentAdmission",
      "text" : "Candidate-to-record enrichment requires separate scoped authority admission after snapshot origin confirmation. Interpretation resolution must use an explicitly enriched record. Missing physical states may remain source-only indefinitely, without a record or Delta. Never auto-upgrade old reports or infer a complete empty state from silence."
    },
    {
      "appliesTo" : [
        "eventcore:Delta",
        "eventcore:EventCandidate",
        "eventcore:RecordedEvent",
        "eventcore:StateObservation",
        "eventcore:StateSnapshot"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:KnownStatesForExactDelta",
      "id" : "KnownStatesForExactDelta",
      "text" : "RecordedEvent directly requires complete StateSnapshots with matching schema/scope/projection, without availability or complete flags on the record path. Delta derives both states through deltaOfRecord and must equal their exact difference. Unknown or partial candidate observations cannot create a record or Delta by substituting empty states or operator review states. Equal explicitly supplied and provenance-confirmed empty snapshots allow an exact empty Delta."
    },
    {
      "appliesTo" : [
        "eventcore:EventRegistry",
        "eventcore:Interpretation",
        "eventcore:RecordedEvent"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:PreserveRecordedObservations",
      "id" : "PreserveRecordedObservations",
      "text" : "A record belongs to exactly one EventRegistry revision, where recordKey is unique; the registry identity is registryKey plus revisionKey. Reinterpreting roles never replaces supplied snapshots. Enrichment preserves known snapshots and all partial facts, and creates a linked new record; this declaration is not an implemented registry service."
    },
    {
      "appliesTo" : [
        "eventcore:InterpretationCandidate",
        "eventcore:SourceAssertion"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:ScopedSourceAttribution",
      "id" : "ScopedSourceAttribution",
      "text" : "Preserve source/revision/digest/quote/speaker identity and episode scope. I in a letter refers to the source author, not automatically the narrator; absent speaker remains unknown. Structural citations do not prove semantic relevance."
    },
    {
      "appliesTo" : [
        "eventcore:DirectObservationOrigin",
        "eventcore:OperatorSnapshotOrigin",
        "eventcore:SourceSnapshotOrigin",
        "eventcore:StateSnapshot"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:SnapshotOriginAdmission",
      "id" : "SnapshotOriginAdmission",
      "text" : "The eventcore-provenance-v1 profile requires exactly one typed origin per snapshot and an explicit scoped authority confirmation bound to exact graph bytes. The authority input is selected by the trusted caller, never self-issued by graph review. Source presence, origin confirmation and factual truth are distinct; no cryptographic identity authentication is implemented."
    }
  ],
