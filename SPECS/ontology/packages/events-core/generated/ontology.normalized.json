  "modelApplicability" : {
    "appliesTo" : {
      "contexts" : [
        "draft_vocabulary_review",
        "offline_consumer_contract_design"
      ],
      "domains" : [
        "general_event_modeling"
      ]
    },
    "assumptions" : [
      {
        "id" : "manual_semantic_review",
        "text" : "Relation cardinality, source relevance, enum values and whole-graph invariants require explicit manual review until ONT-043."
      },
      {
        "id" : "observation_availability",
        "text" : "Unknown or partial observations remain distinct from supplied complete empty snapshots."
      }
    ],
    "excludes" : {
      "contexts" : [
        "automatic_liability_assignment",
        "runtime_graph_enforcement",
        "trusted_physical_causation"
      ]
    },
    "invalidationTriggers" : [
      {
        "id" : "instance_contract_changed",
        "text" : "Re-review package vocabulary and mappings when the ONT-043 InstanceGraph/profile contract is chosen."
      }
    ]
  },
  "namespace" : "eventcore",
  "policies" : [
    {
      "appliesTo" : [
        "eventcore:CausalHypothesis"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:BoundedCausalHypothesis",
      "id" : "BoundedCausalHypothesis",
      "text" : "The bounded R3 profile requires distinct registered endpoints, valid intervals and cause start no later than effect start; overlap is allowed. This text does not execute temporal checks, prove physical causation or transfer responsibility."
    },
    {
      "appliesTo" : [
        "eventcore:EventCandidate",
        "eventcore:Interpretation",
        "eventcore:InterpretationCandidate"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:CandidateAuthorityBoundary",
      "id" : "CandidateAuthorityBoundary",
      "text" : "Candidate review is not event registration, factual truth, human attribution or responsibility. Package validation and generated schemas establish structure only; instance/reference/enum checks require ONT-043 and normative profiles require ONT-044."
    },
    {
      "appliesTo" : [
        "eventcore:Delta",
        "eventcore:EventCandidate",
        "eventcore:StateObservation",
        "eventcore:StateSnapshot"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:KnownStatesForExactDelta",
      "id" : "KnownStatesForExactDelta",
      "text" : "Compute exact Delta only from known complete snapshots with matching schema/scope/projection. Unknown or partial observations yield unavailable Delta; never substitute empty snapshots or the operator's review states. Known equal empty snapshots allow a genuine empty Delta."
    },
    {
      "appliesTo" : [
        "eventcore:Interpretation",
        "eventcore:RecordedEvent"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:PreserveRecordedObservations",
      "id" : "PreserveRecordedObservations",
      "text" : "Keep event records immutable and scoped by unique snapshot/record identities. Reinterpreting roles never replaces supplied observations; enrichment creates a linked new record."
    },
    {
      "appliesTo" : [
        "eventcore:InterpretationCandidate",
        "eventcore:SourceAssertion"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "eventcore:ScopedSourceAttribution",
      "id" : "ScopedSourceAttribution",
      "text" : "Preserve source/revision/digest/quote/speaker identity and episode scope. I in a letter refers to the source author, not automatically the narrator; absent speaker remains unknown. Structural citations do not prove semantic relevance."
    }
  ],
