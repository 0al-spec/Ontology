  "modelApplicability" : {
    "appliesTo" : {
      "contexts" : [
        "draft_vocabulary_review",
        "offline_profile_mapping_design"
      ],
      "domains" : [
        "general_responsibility_modeling"
      ]
    },
    "assumptions" : [
      {
        "id" : "manual_mapping_review",
        "text" : "Cross-node support, role, clock, identity, source relevance and mapping checks remain consumer-owned; scalar fields do not enforce enum strings."
      },
      {
        "id" : "source_and_proof_boundary",
        "text" : "Pinned Lean source reading establishes a mapping boundary only; no adapter, source-truth verifier or new theorem backend is implemented."
      }
    ],
    "excludes" : {
      "contexts" : [
        "automatic_liability_assignment",
        "runtime_responsibility_graph_enforcement",
        "trusted_legal_advice"
      ]
    },
    "invalidationTriggers" : [
      {
        "id" : "profile_source_changed",
        "text" : "Re-review the condition/polarity/context mapping when NormLab profile source or imported event vocabulary changes."
      }
    ]
  },
  "namespace" : "respcore",
  "policies" : [
    {
      "appliesTo" : [
        "respcore:Condition",
        "respcore:ResponsibleRelation"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "respcore:ConditionalRelationPersistence",
      "id" : "ConditionalRelationPersistence",
      "text" : "Origin, continuation and termination are distinct declared conditions. A relation can persist without a current action by its originator. Observed Delta or the R3 relationActive marker alone does not establish the legal applicability or persistence of this ResponsibleRelation."
    },
    {
      "appliesTo" : [
        "respcore:AttributionContext",
        "respcore:ResponsibleRelation"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "respcore:DistinctResponsibilityRoles",
      "id" : "DistinctResponsibilityRoles",
      "text" : "Actor, duty bearer, counterpart, human anchor, responder and recipient are independent roles. The current human-contribution profile has no separate dutyBearer, duty or responseRule scope slots; do not present its result as certification of those metadata fields. Any chosen alignment must be explicit and separately reviewed."
    },
    {
      "appliesTo" : [
        "respcore:Deadline",
        "respcore:DutySpecification",
        "respcore:GroundAssessment"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "respcore:ExplicitOmissionGrounds",
      "id" : "ExplicitOmissionGrounds",
      "text" : "The mapped omission profile requires attributed+, required+, deadlineElapsed+, capable+, exception- and performed- in the same scope. Missing performance evidence is not nonperformance. Deadline metadata alone does not supply elapsed support; external duty applicability is not silently proved by R3."
    },
    {
      "appliesTo" : [
        "respcore:Condition",
        "respcore:GroundAssessment",
        "respcore:ResponsibilityAssessment"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "respcore:IndependentGroundSupport",
      "id" : "IndependentGroundSupport",
      "text" : "No support means unknown; positive-only, negative-only and both polarities remain distinct. Preserve opposing supports. Condition labels and assessment review do not establish truth. The selected NormLab profile requires each requested literal and absence of its opposite, not a full Belnap calculus."
    },
    {
      "appliesTo" : [
        "respcore:AttributionContext",
        "respcore:CertificateReference",
        "respcore:GroundAssessment",
        "respcore:ProfileDefinition",
        "respcore:ResponsibilityAssessment"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "respcore:ScopedBoundMapping",
      "id" : "ScopedBoundMapping",
      "text" : "Use one derived registered event/interpretation context and explicit injective ID mapping. Missing roles, Human proof or registry binding cannot be invented. A ground and certificate derive the same owner context/profile. The eventcore-v1 validator does not admit respcore nodes; this draft adds no responsibility graph checker."
    },
    {
      "appliesTo" : [
        "respcore:ProfileConsequenceCandidate",
        "respcore:ResponseCandidate",
        "respcore:ResponseRule"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "respcore:SeparateConditionalResponse",
      "id" : "SeparateConditionalResponse",
      "text" : "An omission-grounded breachRecorded marker is not an imposed sanction. A response needs its own rule, scoped trigger, authority and recipient. Package approval, workflow review, source truth, profile acceptance and legal responsibility are distinct. This package neither executes response rules nor inserts a physical or normative Delta."
    },
    {
      "appliesTo" : [
        "respcore:CitedSupport",
        "respcore:OperatorSupport"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "respcore:SourceAndOperatorBoundary",
      "id" : "SourceAndOperatorBoundary",
      "text" : "Cited support retains the exact SourceAssertion and speaker. Uncited operator support retains author and rationale and must stay labelled uncited. Citation identity does not establish condition relevance, polarity, human status or factual truth."
    },
    {
      "appliesTo" : [
        "respcore:CertificateReference",
        "respcore:ProfileConsequenceCandidate"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "respcore:SupportSensitiveRevalidation",
      "id" : "SupportSensitiveRevalidation",
      "text" : "Deleting unused mapped facts/rules can preserve a selected Tree under the pinned theorem conditions. Deleting used support requires mapping revalidation; an alternate source may preserve the same literal value. Profile.check must be rechecked after updates: adding opposed grounds or negative effect can reject a still-valid Tree. Never identify source support IDs with Lean literal values."
    }
  ],
