  "modelApplicability" : {
    "appliesTo" : {
      "contexts" : [
        "actor_relative_attribution",
        "domain_neutral_agency",
        "source_only_candidates"
      ],
      "domains" : [
        "general_event_modeling"
      ]
    },
    "assumptions" : [
      {
        "id" : "explicit_reference_consumer",
        "text" : "Generated object schemas do not enforce relational policies. The separate strict TypeScript reference envelope checks only declared inventory/reference constraints."
      },
      {
        "id" : "independent_claims",
        "text" : "Content, attitude, support, review and actual observations are independent; any Entity may remain described without psychological claims."
      }
    ],
    "excludes" : {
      "contexts" : [
        "automatic_normative_classification",
        "automatic_psychological_truth",
        "implicit_instance_profile_extension"
      ]
    },
    "invalidationTriggers" : [
      {
        "id" : "consumer_mapping_changed",
        "text" : "Re-review the consumer profile and dependency pins before changing representation or adding a normative mapping."
      }
    ]
  },
  "namespace" : "agencycore",
  "policies" : [
    {
      "appliesTo" : [
        "agencycore:AgencyContext",
        "agencycore:AnticipationHypothesis",
        "agencycore:AwarenessHypothesis",
        "agencycore:GoalHypothesis",
        "agencycore:IntentionHypothesis",
        "agencycore:OutcomeAttitudeHypothesis"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "agencycore:ActorRelativeScope",
      "id" : "ActorRelativeScope",
      "text" : "Any Entity may occupy actor role without acquiring psychological properties. Context selects one view and optional role reached from that view, named actor; shared role bindings are allowed. An absent actor stays absent. Source speaker and operator author never fill actor by default. Awareness of a motive targets the exact same-view/same-role MotivationHypothesis, not just equal motive text. Awareness of a motivation also requires matching contributionKind; action and omission are not interchangeable on the same view/actor."
    },
    {
      "appliesTo" : [
        "agencycore:AgencyContext",
        "agencycore:AnticipationHypothesis",
        "agencycore:AwarenessHypothesis",
        "agencycore:GoalHypothesis",
        "agencycore:IntentionHypothesis",
        "agencycore:OutcomeAttitudeHypothesis"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "agencycore:ActualConsequencesRemainSeparate",
      "id" : "ActualConsequencesRemainSeparate",
      "text" : "Actual own change follows selected Interpretation -> interpretsRecord -> supplied before/after states and optional exact Delta. A downstream effect requires a separate causal hypothesis and effect record. Source-only candidates need no records, snapshots or Delta. Desired/anticipated content does not establish occurrence or cause, and actual outcomes do not establish prior motives, awareness, goals or anticipation."
    },
    {
      "appliesTo" : [
        "agencycore:AgencyContext",
        "agencycore:AnticipationHypothesis",
        "agencycore:AwarenessHypothesis",
        "agencycore:GoalHypothesis",
        "agencycore:IntentionHypothesis",
        "agencycore:OutcomeAttitudeHypothesis"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "agencycore:AwarenessAndKnowledge",
      "id" : "AwarenessAndKnowledge",
      "text" : "Actor awareness aware/partly_aware/unaware is distinct from analyst uncertainty. Missing awareness claims or evidence do not imply unaware, not_applicable or aware. Explicit not_applicable concerns this property and perspective; it is never a default inferred from Entity kind. An actor may fail to recognize a motive while intentionally contributing or anticipating an outcome."
    },
    {
      "appliesTo" : [
        "agencycore:AgencyContext",
        "agencycore:AnticipationHypothesis",
        "agencycore:AwarenessHypothesis",
        "agencycore:GoalHypothesis",
        "agencycore:IntentionHypothesis",
        "agencycore:OutcomeAttitudeHypothesis"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "agencycore:ContentIsNotObservation",
      "id" : "ContentIsNotObservation",
      "text" : "PropositionContent is unasserted content about a situation or history, not a physical StateSnapshot, observed Fact, full state or actual Delta. Goals may seek, avoid or maintain a condition; no change is required for a maintenance goal. Unknown actual outcomes never become empty states or empty differences. Matching content to actual observations requires a separately reviewed semantic mapping."
    },
    {
      "appliesTo" : [
        "agencycore:AgencyContext",
        "agencycore:AnticipationHypothesis",
        "agencycore:AwarenessHypothesis",
        "agencycore:GoalHypothesis",
        "agencycore:IntentionHypothesis",
        "agencycore:OutcomeAttitudeHypothesis"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "agencycore:DistinctTimes",
      "id" : "DistinctTimes",
      "text" : "Perspective time describes when the attributed stance applies; report time describes the account. Each known time requires its own clock/instant pair. Neither supplies the other. Unknown times remain absent. Distinct clocks are not ordered without an external mapping; even comparable supplied times are declarations, not verified chronology. Intentions may arise during an ongoing contribution; no blanket before-start constraint is imposed."
    },
    {
      "appliesTo" : [
        "agencycore:AgencyContext",
        "agencycore:AnticipationHypothesis",
        "agencycore:AwarenessHypothesis",
        "agencycore:GoalHypothesis",
        "agencycore:IntentionHypothesis",
        "agencycore:OutcomeAttitudeHypothesis"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "agencycore:DomainNeutralExtension",
      "id" : "DomainNeutralExtension",
      "text" : "No normative or psychological classification is produced by these primitives. A consumer may define separately versioned mappings and additional applicability grounds. agency-source-attribution/v1 checks only its bounded reference envelope against caller-supplied indexes; it is not universal InstanceGraph admission, graph-byte authentication, source relevance, truth, chronology or a proof backend. Existing profile pins and saved reports remain unchanged."
    },
    {
      "appliesTo" : [
        "agencycore:AgencyContext",
        "agencycore:AnticipationHypothesis",
        "agencycore:AwarenessHypothesis",
        "agencycore:GoalHypothesis",
        "agencycore:IntentionHypothesis",
        "agencycore:OutcomeAttitudeHypothesis"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "agencycore:IndependentAgencyClaims",
      "id" : "IndependentAgencyClaims",
      "text" : "Each axis has a separate hypothesis, review lifecycle and positive/negative support. Motive does not entail goal; goal does not entail commitment; commitment does not entail performance; anticipation does not entail desire; lack of desire does not entail opposition. Claims with no supplied support remain unsupported. Both signs may coexist without erasure or arbitrary inference."
    },
    {
      "appliesTo" : [
        "agencycore:AgencyContext",
        "agencycore:AnticipationHypothesis",
        "agencycore:AwarenessHypothesis",
        "agencycore:GoalHypothesis",
        "agencycore:IntentionHypothesis",
        "agencycore:OutcomeAttitudeHypothesis"
      ],
      "enforceability" : "manual",
      "extends" : "sg:Policy",
      "fqid" : "agencycore:SourceAndReviewBoundary",
      "id" : "SourceAndReviewBoundary",
      "text" : "Each hypothesis retains its own source/uncited-operator support and review state. Reusing a SourceAssertion does not authenticate it or transfer its relevance to another claim. Reviewed is workflow, not truth; rejected does not negate content. Independent support presence is unknown/supported/opposed/contested, never a duplicate world truth field."
    }
  ],
