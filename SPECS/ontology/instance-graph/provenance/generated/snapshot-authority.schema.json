{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "description" : "Caller-selected trusted input; no identity authentication or source truth. Cross-input binding and scoped admission require validate-instances.",
  "properties" : {
    "apiVersion" : {
      "const" : "ontology.specgraph.io/snapshot-authority/v1alpha1"
    },
    "confirmations" : {
      "items" : {
        "additionalProperties" : false,
        "properties" : {
          "authorityKey" : {
            "minLength" : 1,
            "type" : "string"
          },
          "originId" : {
            "minLength" : 1,
            "type" : "string"
          },
          "rationale" : {
            "minLength" : 1,
            "type" : "string"
          },
          "snapshotId" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [
          "authorityKey",
          "originId",
          "rationale",
          "snapshotId"
        ],
        "type" : "object"
      },
      "maxItems" : 10000,
      "type" : "array"
    },
    "enrichments" : {
      "items" : {
        "additionalProperties" : false,
        "properties" : {
          "authorityKey" : {
            "minLength" : 1,
            "type" : "string"
          },
          "candidateId" : {
            "minLength" : 1,
            "type" : "string"
          },
          "rationale" : {
            "minLength" : 1,
            "type" : "string"
          },
          "recordId" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [
          "authorityKey",
          "candidateId",
          "rationale",
          "recordId"
        ],
        "type" : "object"
      },
      "maxItems" : 10000,
      "type" : "array"
    },
    "grants" : {
      "items" : {
        "additionalProperties" : false,
        "properties" : {
          "authorityKey" : {
            "minLength" : 1,
            "type" : "string"
          },
          "capabilities" : {
            "items" : {
              "enum" : [
                "confirm-source",
                "confirm-observation",
                "supply-operator-state",
                "enrich-candidate"
              ]
            },
            "maxItems" : 4,
            "minItems" : 1,
            "type" : "array",
            "uniqueItems" : true
          },
          "projectionKeys" : {
            "items" : {
              "minLength" : 1,
              "type" : "string"
            },
            "maxItems" : 1000,
            "minItems" : 1,
            "type" : "array",
            "uniqueItems" : true
          },
          "scopeKeys" : {
            "items" : {
              "minLength" : 1,
              "type" : "string"
            },
            "maxItems" : 1000,
            "minItems" : 1,
            "type" : "array",
            "uniqueItems" : true
          }
        },
        "required" : [
          "authorityKey",
          "capabilities",
          "projectionKeys",
          "scopeKeys"
        ],
        "type" : "object"
      },
      "maxItems" : 10000,
      "type" : "array"
    },
    "graphKey" : {
      "pattern" : "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type" : "string"
    },
    "graphSHA256" : {
      "pattern" : "^[a-f0-9]{64}$",
      "type" : "string"
    },
    "kind" : {
      "const" : "SnapshotProvenanceAuthority"
    },
    "profilePin" : {
      "additionalProperties" : false,
      "properties" : {
        "definitionSHA256" : {
          "const" : "240d518666905c320df299b5d4d9e08e7c2564b0ca97ca2ab15d0a275dbe2551"
        },
        "id" : {
          "const" : "eventcore-provenance-v1"
        },
        "version" : {
          "const" : "1.0.0"
        }
      },
      "required" : [
        "definitionSHA256",
        "id",
        "version"
      ],
      "type" : "object"
    },
    "revisionKey" : {
      "pattern" : "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type" : "string"
    }
  },
  "required" : [
    "apiVersion",
    "confirmations",
    "enrichments",
    "grants",
    "graphKey",
    "graphSHA256",
    "kind",
    "profilePin",
    "revisionKey"
  ],
  "type" : "object"
}
