{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "examcalc-schemas.ts",
    "events-core-schemas.ts",
    "responsibility-core-schemas.ts",
    "../packages/responsibility-core/generated/**/*.ts",
    "instance-graph-contract.ts",
    "../instance-graph/generated/**/*.ts",
    "../packages/examcalc/generated/**/*.ts",
    "../packages/events-core/generated/**/*.ts",
    "snapshot-provenance.ts",
    "../packages/events-core/versions/0.2.0/generated/**/*.ts",
    "../instance-graph/provenance/generated/**/*.ts",
    "motivation-core-schemas.ts",
    "../packages/motivation-core/generated/**/*.ts",
    "agency-core-schemas.ts",
    "../packages/agency-core/generated/**/*.ts",
    "../packages/agency-core/consumer/**/*.ts"
  ]
}
